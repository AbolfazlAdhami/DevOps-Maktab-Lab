# Private DNS for the Multipass lab network.
domain={{ lab_domain }}
local=/.{{ lab_domain }}/
listen-address=127.0.0.1,{{ ansible_facts['default_ipv4']['address'] }}
bind-interfaces
no-resolv
server=1.1.1.1
server=8.8.8.8
cache-size=1000
host-record=devops-ubuntu.{{ lab_domain }},{{ ansible_facts['default_ipv4']['address'] }}
host-record=vm.{{ lab_domain }},{{ ansible_facts['default_ipv4']['address'] }}